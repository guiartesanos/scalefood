# Copie este arquivo pra ".env.local" e preencha com os dados do seu
# projeto Supabase (Configurações do Projeto > API).
# NUNCA cometa o .env.local de verdade no git — ele já está no .gitignore.

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui

# Service role key — só usada em Server Actions (nunca chega no
# navegador). Fica em Configurações do Projeto > API > service_role.
# ATENÇÃO: essa chave dá acesso total ao banco, ignorando RLS. Trate
# como senha de root.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui

# URL pública do site (pra montar os links de convite/redefinição de
# senha nos emails). Em produção, o domínio da Vercel; em dev, localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
